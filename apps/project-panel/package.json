{
  "name": "@architecture-kit/project-panel",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-server/server.d.ts",
      "default": "./dist-server/server.js"
    },
    "./snapshot": {
      "types": "./dist-server/snapshot.d.ts",
      "default": "./dist-server/snapshot.js"
    },
    "./runtime-port": {
      "types": "./dist-server/runtime-port.d.ts",
      "default": "./dist-server/runtime-port.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "build:server": "tsc -b tsconfig.json",
    "start": "node ./dist-server/server.js",
    "typecheck": "tsc -p tsconfig.ui.json"
  },
  "dependencies": {
    "markdown-it": "14.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3"
  }
}
