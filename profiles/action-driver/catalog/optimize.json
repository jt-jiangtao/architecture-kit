    {
      "id": "rollout-append-read",
      "kind": "gate",
      "title": "长历史追加与增量读取预算",
      "target": "packages/agent/runtime-storage/src/rollout/request-event-view.ts",
      "hypothesis": "1000 与 32000 行历史下，长会话中位数应低于 10ms 且不超过短会话两倍",
      "inputs": [
        "profile:action-driver/probes/hot-path-cost.fixture.ts",
        "profile:action-driver/probes/vitest-probe.mjs"
      ],
      "check": [
        "node",
        "profile:action-driver/probes/vitest-probe.mjs",
        "hot-path-cost"
      ]
    },
    {
      "id": "shell-raw",
      "kind": "metric",
      "title": "桌面启动包 raw",
      "target": "profile:action-driver/probes/measure-loading-performance.mjs",
      "hypothesis": "核对按需加载后启动包字节数",
      "inputs": [
        "profile:action-driver/probes/evidence.mjs",
        "profile:action-driver/probes/loading-performance.test.mjs"
      ],
      "check": [
        "node",
        "--test",
        "profile:action-driver/probes/loading-performance.test.mjs"
      ],
      "measure": [
        "node",
        "profile:action-driver/probes/evidence.mjs",
        "shell",
        "raw"
