specification { element component }
model {
  localHarness = component 'Local Harness' {
    description '装配本地工具、模型网关和仓储，注册并释放 provider 订阅。'
  }
  agentRuntime = component 'Agent Runtime' {
    description '执行任务图，用稳定的线程标识访问任务检查点。'
  }
  localHarness -> agentRuntime '装配 LangGraphRunner 并注入宿主端口'
}
views {
  view localAssembly { include * }
}
