{
  "name": "architecture-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Code-native architecture knowledge compiler for humans and coding agents",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "project:panel": "pnpm build && pnpm --filter @architecture-kit/project-panel build && pnpm --filter @architecture-kit/project-panel start",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p apps/project-panel/tsconfig.ui.json",
    "clean": "tsc -b --clean",
    "lint": "eslint bin scripts tests eslint.config.mjs",
    "gate": "node bin/architecture-kit.mjs gate run --profile presubmit",
    "format:check": "prettier --check \"packages/**/*.ts\" \"apps/**/*.ts\" \"apps/**/*.tsx\"",
    "check:boundaries": "node --test tests/boundaries.test.mjs",
    "skills:list": "skills list",
    "skills:check": "skills check",
    "skills:restore": "skills experimental_install",
    "skills:update": "skills update -p",
    "codex:configure": "node scripts/codex-development.mjs configure",
    "codex:check": "node scripts/codex-development.mjs check",
    "codex:capture": "node scripts/codex-development.mjs capture",
    "agent-tools:status": "node scripts/agent-development-tools.mjs status",
    "agent-tools:install": "node scripts/agent-development-tools.mjs install",
    "ripwire-project": "node scripts/agent-ripwire.mjs",
    "eval:codex-development": "node evals/codex-development/run.mjs",
    "test": "node --test tests/*.test.mjs tests/profile/legacy/*.test.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.10.1",
    "skills": "1.7.4"
  },
  "packageManager": "pnpm@12.4.1",
  "bin": {
    "architecture-kit": "./bin/architecture-kit.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./core-ir": {
      "types": "./packages/core-ir/dist/index.d.ts",
      "default": "./packages/core-ir/dist/index.js"
    },
    "./config": {
      "types": "./packages/config/dist/index.d.ts",
      "default": "./packages/config/dist/index.js"
    },
    "./presets/eslint": {
      "types": "./packages/presets/dist/eslint.d.ts",
      "default": "./packages/presets/dist/eslint.js"
    },
    "./presets/prettier": {
      "types": "./packages/presets/dist/prettier.d.ts",
      "default": "./packages/presets/dist/prettier.js"
    },
    "./presets/ruff.toml": "./packages/presets/ruff.toml",
    "./presets/tsconfig.base.json": "./packages/presets/tsconfig.base.json",
    "./profiles/action-driver/*": "./profiles/action-driver/*"
  },
  "files": [
    "bin",
    "dist",
    "packages",
    "apps/cli/dist",
    "apps/mcp-server/dist",
    "apps/dev-server/dist",
    "apps/project-panel/dist",
    "apps/project-panel/dist-server",
    "profiles",
    "skills"
  ],
  "dependencies": {
    "@architecture-kit/cli": "workspace:*",
    "@architecture-kit/config": "workspace:*",
    "@architecture-kit/core-ir": "workspace:*",
    "@ast-grep/cli": "0.51.0",
    "@likec4/core": "1.60.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@rspress/core": "2.0.23",
    "chokidar": "4.0.3",
    "dependency-cruiser": "16.10.4",
    "entities": "6.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-unused-imports": "4.4.1",
    "get-tsconfig": "4.14.3",
    "inversify": "8.3.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "likec4": "1.60.0",
    "markdown-it": "14.3.3",
    "oxc-parser": "0.155.0",
    "prettier": "3.7.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "resolve-pkg-maps": "1.0.0",
    "syncpack": "15.3.3",
    "tar": "7.5.22",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
