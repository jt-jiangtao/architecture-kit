      "source": "git+https://github.com/oraios/serena@ede329aaf0c824bea75455a2926f01420d7aa620",
      "python": "3.13",
      "skill": null
    },
    "rtk": {
      "kind": "brew",
      "command": "rtk",
      "version": "1.1.0",
      "versionArgs": ["--version"],
      "formula": "rtk",
      "skill": null
    },
    "context7": {
      "kind": "npm",
      "command": "ctx7",
      "version": "0.8.2",
      "versionArgs": ["--version"],
      "package": "ctx7",
      "minimumNode": "22.13.0",
      "skill": "context7"
    },
    "ripwire": {
      "kind": "github-release-script",
      "command": "ripwire",
      "version": "0.6.9",
