    "playwright": {
      "kind": "npm",
      "command": "playwright-cli",
      "version": "0.1.22",
      "versionArgs": ["--version"],
      "package": "@playwright/cli",
      "minimumNode": "18.0.0",
      "skill": "playwright-cli"
    }
